{
  "name": "leeco-partshub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "樂創元件库 Leeco PartsHub — 个人元器件库存管理系统（EdgeOne Serverless / Vue 3）",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node tools/dev-server/index.mjs",
    "dev:all": "node tools/dev-server/run.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:unit && npm run test:api",
    "test:unit": "node tests/unit/run.mjs",
    "test:api": "node tests/integration/api-contract.mjs",
    "test:e2e": "node tests/e2e/ui-efficiency.mjs",
    "seed": "node tools/seed/demo.mjs seed",
    "seed:clean": "node tools/seed/demo.mjs clean",
    "check": "npm run check:paths && npm run typecheck && npm run test:unit && npm run test:api && npm run build",
    "test:e2e:report": "node tests/e2e/ui-report-improvements.mjs",
    "check:paths": "node tools/scripts/check-portability.mjs",
    "verify:modules": "node tests/verification/modules.mjs",
    "verify:ui": "node tests/verification/ui-modules.mjs",
    "verify": "npm run check && npm run verify:modules && npm run verify:ui"
  },
  "dependencies": {
    "naive-ui": "^2.40.1",
    "pinia": "^2.2.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
